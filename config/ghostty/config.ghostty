# Ghostty configuration

# ---------------------------------------------------------------------------
# Theme
# ---------------------------------------------------------------------------

theme = Gruvbox Dark

# ---------------------------------------------------------------------------
# Font
# ---------------------------------------------------------------------------

# Nerd Font variant: provides the icons used by starship and tmux.
font-family = Maple Mono NF
font-size = 13
font-thicken = false

# ---------------------------------------------------------------------------
# Window
# ---------------------------------------------------------------------------

background-opacity = .9
background-blur = true

window-padding-x = 7
window-padding-y = 7

window-decoration = true
window-theme = auto
macos-titlebar-style = hidden

resize-overlay = always

# ---------------------------------------------------------------------------
# Cursor
# ---------------------------------------------------------------------------

cursor-style = block
cursor-style-blink = true
cursor-click-to-move = true

# ---------------------------------------------------------------------------
# Shell integration
# ---------------------------------------------------------------------------

shell-integration = detect
# ssh-env / ssh-terminfo make xterm-ghostty work on servers that don't know it.
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

# ---------------------------------------------------------------------------
# Clipboard
# ---------------------------------------------------------------------------

# Writes let Vim and tmux yank over SSH. Reads stay on "ask": with "allow",
# any program, including one on a remote server, could read your clipboard.
clipboard-read = ask
clipboard-write = allow
copy-on-select = clipboard

# ---------------------------------------------------------------------------
# Keyboard
# ---------------------------------------------------------------------------

# Left Option acts as Alt (Alt-b / Alt-f in zsh, Vim, tmux). Right Option stays
# available for AZERTY characters such as { [ | ~.
macos-option-as-alt = left

# ---------------------------------------------------------------------------
# Mouse
# ---------------------------------------------------------------------------

mouse-hide-while-typing = true

# ---------------------------------------------------------------------------
# Quick terminal
# ---------------------------------------------------------------------------

keybind = global:super+shift+space=toggle_quick_terminal

quick-terminal-position = right
quick-terminal-screen = main
quick-terminal-animation-duration = 0.2
quick-terminal-size = 70%
