// Zed settings
//
// https://zed.dev/docs/configuring-zed

{
    // -----------------------------------------------------------------------
    // Appearance
    // -----------------------------------------------------------------------

    "cli_default_open_behavior": "existing_window",
    "theme": "Catppuccin Macchiato",
    "icon_theme": "Catppuccin Macchiato",

    "buffer_font_family": "Victor Mono",
    "buffer_font_size": 12.0,
    "buffer_font_weight": 400.0,
    "buffer_line_height": {
        "custom": 1.7,
    },
    "ui_font_size": 14,

    "cursor_shape": "bar",
    "cursor_blink": false,
    "current_line_highlight": "all",

    "relative_line_numbers": "enabled",

    "active_pane_modifiers": {
        "border_size": 0.0,
        "inactive_opacity": 0.4,
    },

    // -----------------------------------------------------------------------
    // Editor
    // -----------------------------------------------------------------------

    "vim_mode": true,

    "hard_tabs": false,
    "tab_size": 4,

    "preferred_line_length": 140,
    "soft_wrap": "prefer_line",

    "show_whitespaces": "all",

    "use_autoclose": true,

    "enable_language_server": true,
    "format_on_save": "on",

    // -----------------------------------------------------------------------
    // Inlay hints
    // -----------------------------------------------------------------------

    "inlay_hints": {
        "enabled": true,
        "show_type_hints": true,
        "show_parameter_hints": true,
        "show_other_hints": true,
        "show_background": false,
        "edit_debounce_ms": 700,
        "scroll_debounce_ms": 50,
        "toggle_on_modifiers_press": null,
    },

    // -----------------------------------------------------------------------
    // Diagnostics
    // -----------------------------------------------------------------------

    "diagnostics": {
        "include_warnings": true,
        "inline": {
            "enabled": true,
            "update_debounce_ms": 150,
            "padding": 4,
            "min_column": 0,
            "max_severity": null,
        },
    },

    // -----------------------------------------------------------------------
    // Project panel
    // -----------------------------------------------------------------------

    "project_panel": {
        "dock": "right",
        "indent_size": 14,
        "auto_fold_dirs": false,
        "scrollbar": {
            "show": "auto",
        },
    },

    "outline_panel": {
        "button": false,
    },

    // -----------------------------------------------------------------------
    // Tabs
    // -----------------------------------------------------------------------

    "tabs": {
        "close_position": "right",
        "file_icons": true,
        "git_status": true,
        "activate_on_close": "history",
        "show_close_button": "hover",
        "show_diagnostics": "all",
    },

    "tab_bar": {
        "show": true,
        "show_nav_history_buttons": false,
    },

    // -----------------------------------------------------------------------
    // Toolbar
    // -----------------------------------------------------------------------

    "toolbar": {
        "breadcrumbs": false,
        "quick_actions": false,
        "selections_menu": false,
    },

    // -----------------------------------------------------------------------
    // Scrollbar
    // -----------------------------------------------------------------------

    "scrollbar": {
        "show": "auto",
        "cursors": true,
        "git_diff": true,
        "search_results": true,
        "selected_text": true,
        "selected_symbol": true,
        "diagnostics": "all",
        "axes": {
            "horizontal": true,
            "vertical": true,
        },
    },

    // -----------------------------------------------------------------------
    // Vim
    // -----------------------------------------------------------------------

    "vim": {
        "toggle_relative_line_numbers": true,
    },

    // -----------------------------------------------------------------------
    // Language servers
    // -----------------------------------------------------------------------

    "lsp": {
        "vtsls": {
            "settings": {
                "javascript": {
                    "format_on_save": "off",
                    "inlayHints": {
                        "parameterNames": {
                            "enabled": "all",
                            "suppressWhenArgumentMatchesName": false,
                        },
                        "parameterTypes": {
                            "enabled": true,
                        },
                        "variableTypes": {
                            "enabled": true,
                            "suppressWhenTypeMatchesName": true,
                        },
                        "propertyDeclarationTypes": {
                            "enabled": true,
                        },
                        "functionLikeReturnTypes": {
                            "enabled": true,
                        },
                        "enumMemberValues": {
                            "enabled": true,
                        },
                    },
                },
                "typescript": {
                    "format_on_save": "off",
                    "inlayHints": {
                        "parameterNames": {
                            "enabled": "all",
                            "suppressWhenArgumentMatchesName": false,
                        },
                        "parameterTypes": {
                            "enabled": true,
                        },
                        "variableTypes": {
                            "enabled": true,
                            "suppressWhenTypeMatchesName": true,
                        },
                        "propertyDeclarationTypes": {
                            "enabled": true,
                        },
                        "functionLikeReturnTypes": {
                            "enabled": true,
                        },
                        "enumMemberValues": {
                            "enabled": true,
                        },
                    },
                },
            },
        },
    },

    // -----------------------------------------------------------------------
    // Languages
    // -----------------------------------------------------------------------

    "languages": {
        "Vue.js": {
            "soft_wrap": "prefer_line",
        },

        "PHP": {
            "soft_wrap": "prefer_line",
            "language_servers": ["intelephense", "!phpactor", "..."],
        },

        "Markdown": {
            "soft_wrap": "prefer_line",
            "remove_trailing_whitespace_on_save": false,
        },

        "YAML": {
            "tab_size": 2,
        },

        "Helm": {
            "tab_size": 2,
        },
    },

    "file_types": {
        "Helm": [
            "**/templates/**/*.tpl",
            "**/templates/**/*.yaml",
            "**/templates/**/*.yml",
            "**/helmfile.d/**/*.yaml",
            "**/helmfile.d/**/*.yml",
            "shared/rbac/*.yml",
        ],
    },

    // -----------------------------------------------------------------------
    // Startup
    // -----------------------------------------------------------------------

    "restore_on_startup": "last_session",
    "base_keymap": "VSCode",

    // -----------------------------------------------------------------------
    // Predictions / AI
    // -----------------------------------------------------------------------

    "edit_predictions": {
        "provider": "none",
        "disabled_globs": ["**/.env*", "**/*.pem", "**/*.key", "**/*.cert", "**/*.crt", "**/.dev.vars", "**/secrets.yml"],
    },

    "agent": {
        "enabled": false,
    },

    // -----------------------------------------------------------------------
    // Telemetry
    // -----------------------------------------------------------------------

    "telemetry": {
        "diagnostics": true,
        "metrics": true,
    },

    // -----------------------------------------------------------------------
    // Misc
    // -----------------------------------------------------------------------

    "hide_mouse": "on_typing",
    "unnecessary_code_fade": 0.8,

    // -----------------------------------------------------------------------
    // Theme tweaks
    // -----------------------------------------------------------------------

    "experimental.theme_overrides": {
        "syntax": {
            "comment": {
                "font_style": "italic",
            },
            "comment.doc": {
                "font_style": "italic",
            },
            "keyword": {
                "font_style": "italic",
            },
        },
    },
}
